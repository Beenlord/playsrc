{
  "name": "play-src",
  "type": "module",
  "main": "server.js",
  "imports": {
    "#*": "./app/*"
  },
  "scripts": {
    "dev": "concurrently 'vite' 'nodemon'",
    "build": "vite build",
    "start": "node app/app.js"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "dotenv": "^17.2.3",
    "lodash": "^4.17.21",
    "pinia": "^3.0.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "vite": "^7.1.12"
  },
  "nodemonConfig": {
    "exec": "node app/app.js",
    "verbose": false,
    "watch": [
      "*"
    ],
    "ignore": [
      "node_modules",
      "app/src",
      "build"
    ]
  }
}
